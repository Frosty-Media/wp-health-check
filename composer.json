{
  "name": "frosty-media/wp-health-check",
  "description": "A simple WordPress health check endpoint.",
  "license": "MIT",
  "authors": [
    {
      "name": "Austin Passy",
      "email": "367897+thefrosty@users.noreply.github.com",
      "homepage": "https://austin.passy.co/"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "roots/wordpress-core-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.4",
    "symfony/http-foundation": "^7.4 || ^8.1.11"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpcompatibility/php-compatibility": "*",
    "phpstan/extension-installer": "^1.4",
    "roots/wordpress": "^7.1",
    "slevomat/coding-standard": "~8.18",
    "squizlabs/php_codesniffer": "^3.13 || ^4.0.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "vimeo/psalm": "^7.3",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "FrostyMedia\\WpHealthCheck\\": "src/"
    }
  },
  "scripts": {
    "phpcs": [
      "./vendor/bin/phpcs --standard=phpcs-ruleset.xml"
    ],
    "psalm": [
      "./vendor/bin/psalm"
    ]
  }
}
